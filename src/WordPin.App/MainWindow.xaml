<Window x:Class="WordPin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordPin"
        Width="360"
        Height="260"
        MinWidth="280"
        MinHeight="180"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="WordPin"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="2"
                   Text="Windows 11 x64 · 工程骨架"
                   Foreground="#666666" />

        <Border Grid.Row="3"
                Margin="0,16,0,12"
                Padding="12"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="项目已连接"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0"
                           Text="下一步将接入快速收词和本地数据层。"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="置顶窗口技术验证已启用"
                   Foreground="#4A7C59" />
    </Grid>
</Window>
