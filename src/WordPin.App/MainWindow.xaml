<Window x:Class="WordPin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WordPin"
        Width="360"
        Height="430"
        MinWidth="280"
        MinHeight="180"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="WordPin"
                   FontSize="24"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="2"
                   Text="Windows 11 x64 · 工程骨架"
                   Foreground="#666666" />

        <Border Grid.Row="3"
                Margin="0,16,0,12"
                Padding="12"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="8">
            <StackPanel>
                <TextBlock Text="快速收词"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,0"
                           Text="先复制单词或短语，再点击“读取剪贴板”。应用只在你主动操作时读取一次。"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="DefinitionTextBlock"
                           Margin="0,12,0,0"
                           Text="本地释义：等待收词"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBox x:Name="TermTextBox"
                 Grid.Row="4"
                 MinHeight="32"
                 Margin="0,0,0,8"
                 Padding="8,5"
                 ToolTip="也可以直接输入单词或短语"
                 TextWrapping="Wrap" />

        <StackPanel Grid.Row="5"
                    Margin="0,0,0,12"
                    Orientation="Horizontal">
            <Button Width="120"
                    Margin="0,0,8,0"
                    Click="ReadClipboardButton_Click"
                    Content="读取剪贴板" />
            <Button Width="120"
                    Click="SaveInputButton_Click"
                    Content="保存输入" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal">
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Text="置顶窗口已启用"
                       Foreground="#4A7C59"
                       TextWrapping="Wrap" />
            <Button x:Name="UndoButton"
                    Margin="12,0,0,0"
                    Padding="8,3"
                    Click="UndoButton_Click"
                    Content="撤销"
                    Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="ReviewPanel"
                    Grid.Row="7"
                    Margin="0,12,0,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="MasteryTextBlock"
                       Margin="0,0,0,8"
                       FontWeight="SemiBold"
                       Text="熟练度：L0 · 0 分" />
            <StackPanel Orientation="Horizontal">
                <Button Width="64"
                        Margin="0,0,6,0"
                        Click="ReviewButton_Click"
                        Content="AGAIN"
                        Tag="Again" />
                <Button Width="64"
                        Margin="0,0,6,0"
                        Click="ReviewButton_Click"
                        Content="HARD"
                        Tag="Hard" />
                <Button Width="64"
                        Margin="0,0,6,0"
                        Click="ReviewButton_Click"
                        Content="GOOD"
                        Tag="Good" />
                <Button Width="64"
                        Click="ReviewButton_Click"
                        Content="EASY"
                        Tag="Easy" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
