<Window x:Class="WordPin.App.LlmSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="联网释义与 AI 设置"
        Width="520"
        Height="520"
        MinWidth="440"
        MinHeight="360"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CheckBox x:Name="EnabledCheckBox"
                  Content="本地没有释义时启用 AI 补全"
                  FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock Text="API Base URL（OpenAI 兼容接口）" />
            <TextBox x:Name="BaseUrlTextBox" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="模型名称" />
            <TextBox x:Name="ModelTextBox" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="API Key（保存时使用 Windows 当前用户加密）" />
            <PasswordBox x:Name="ApiKeyPasswordBox" Margin="0,4,0,0" />
            <TextBlock Text="留空表示保留现有 Key。应用不会把 Key 写入 SQLite 或日志。"
                       Foreground="#666666"
                       TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="每日最多请求次数" />
                <TextBox x:Name="DailyLimitTextBox" Margin="0,4,0,0" />
            </StackPanel>
            <CheckBox x:Name="SendContextCheckBox"
                      Grid.Column="2"
                      Margin="0,22,0,0"
                      Content="允许发送选中的例句上下文" />
        </Grid>
        <Border Grid.Row="5"
                Margin="0,14,0,0"
                Padding="10"
                BorderBrush="#D9D9D9"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <CheckBox x:Name="OnlineTranslationEnabledCheckBox"
                          Content="本地没有释义时启用免费联网翻译（MyMemory）"
                          FontWeight="SemiBold" />
                <CheckBox x:Name="OnlineMachineTranslationCheckBox"
                          Margin="0,8,0,0"
                          Content="人工翻译记忆不足时允许机器翻译回退" />
                <StackPanel Margin="0,8,0,0"
                            Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Text="联网翻译每日最多请求次数" />
                    <TextBox x:Name="OnlineTranslationDailyLimitTextBox"
                             Width="70"
                             Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0"
                           Foreground="#666666"
                           Text="只发送当前单词或短语，不发送剪贴板上下文；结果会标记为待确认。"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ValidationTextBlock"
                   Grid.Row="6"
                   Margin="0,12,0,0"
                   Foreground="IndianRed"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="7"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="80"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"
                    Content="取消" />
            <Button Width="80"
                    Click="SaveButton_Click"
                    Content="保存"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
